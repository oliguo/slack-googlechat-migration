# =============================================================================
# Slack Configuration
# =============================================================================
# Slack Bot User OAuth Token (starts with xoxb-)
# Required scopes: channels:history, channels:read, groups:history, groups:read,
#                  users:read, reactions:read, files:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# (Optional) Comma-separated list of channel names to migrate.
# Leave empty to migrate ALL channels the bot has access to.
SLACK_CHANNELS=general,engineering,random

# --- For prepare_channels.py only ---
# Slack User OAuth Token (starts with xoxp-) — needed for unarchiving & inviting.
# Required scopes: channels:read, groups:read, channels:manage, groups:write,
#                  channels:join
# SLACK_USER_TOKEN=xoxp-your-slack-user-token

# The bot's Slack User ID (e.g. U0123456789). Find it in the app's "About" tab
# or run: slack_client.auth_test() → user_id
# SLACK_BOT_USER_ID=U0123456789

# =============================================================================
# Google Chat Configuration
# =============================================================================
# Authentication mode: "oauth" (recommended) or "service_account"
GOOGLE_AUTH_MODE=oauth

# --- Option A: OAuth Desktop App (recommended, works with org policies) ---
# Path to the OAuth client secret JSON file downloaded from Cloud Console
GOOGLE_OAUTH_CLIENT_SECRET_PATH=./client_secret.json

# --- Option B: Service Account (requires key creation to be allowed) ---
# Path to the Google Cloud Service Account JSON key file
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service_account.json
# Google Workspace admin email for domain-wide delegation
# GOOGLE_DELEGATED_USER_EMAIL=admin@yourcompany.com

# =============================================================================
# Migration Options
# =============================================================================
# Prefix for created Google Chat Space names (optional)
SPACE_NAME_PREFIX=[Migrated]

# Maximum messages per second to send to Google Chat (rate limiting)
GCHAT_RATE_LIMIT=2

# Whether to include file attachment URLs in messages (true/false)
INCLUDE_FILE_LINKS=true

# =============================================================================
# File Download Options (download_files.py)
# =============================================================================
# Directory to save downloaded Slack files (default: downloads)
# DOWNLOAD_DIR=downloads

# Number of parallel download workers (default: 4)
# DOWNLOAD_WORKERS=4

# Max retry attempts per file on network errors (default: 5)
# DOWNLOAD_MAX_RETRIES=5

# (Optional) Comma-separated channel names to download files from.
# Leave empty to download from ALL channels.
# DOWNLOAD_CHANNELS=general,engineering

# Auto-invite Slack channel members to the migrated Google Chat Space (true/false)
INVITE_MEMBERS=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
